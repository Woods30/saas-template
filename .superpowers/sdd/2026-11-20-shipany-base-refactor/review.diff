-  }
-  const last = attempts[attempts.length - 1];
-  return {
-    submitted: list.length,
-    results: [
-      {
-        ok: last.status === 200 || last.status === 202,
-        count: list.length,
-        attempts,
-      },
-    ],
-  };
-}

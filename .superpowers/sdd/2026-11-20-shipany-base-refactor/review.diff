@@ -0,0 +1,257 @@
+'use client';
+
+import { useCallback, useEffect, useState, type ReactNode } from 'react';
+import { Link } from '@tanstack/react-router';
+import { CornerDownRight, Search } from 'lucide-react';
+
+import {
+  searchDocs,
+  type DocEntry,
+  type DocSearchResult,
+} from '@/modules/docs/paths';
+import { m } from '@/paraglide/messages.js';
+import { DOC_FALLBACK_ICON, DOC_ICON } from '@/components/docs/doc-icons';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogTitle,
+} from '@/components/ui/dialog';
+import { Input } from '@/components/ui/input';
+
+/**
+ * Documentation search.
+ *
+ * The trigger lives in the sidebar, the results in a dialog — a 240px
+ * sidebar has no room for a result list. The search itself is client side:
+ * results appear once a query is typed.
+ */
+export function DocsSearch({
+  docs,
+  open,
+  onOpenChange,
+}: {
+  docs: DocEntry[];
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+}) {
+  const [internalOpen, setInternalOpen] = useState(false);
+  const isControlled = open !== undefined;
+  const openState = isControlled ? open : internalOpen;
+  const [query, setQuery] = useState('');
+
+  const results = searchDocs(docs, query);
+  const hasQuery = query.trim() !== '';
+
+  const setOpen = useCallback(
+    (next: boolean) => {
+      if (!isControlled) setInternalOpen(next);
+      onOpenChange?.(next);
+      // Closing resets the query so the next open starts empty.
+      if (!next) setQuery('');
+    },
+    [isControlled, onOpenChange]
+  );
+
+  // ⌘K / Ctrl+K — the trigger advertises it, so it has to work.
+  useEffect(() => {
+    if (openState) return;
+    function onKeyDown(event: KeyboardEvent) {
+      if (event.key.toLowerCase() !== 'k' || !(event.metaKey || event.ctrlKey))
+        return;
+      event.preventDefault();
+      setOpen(true);
+    }
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, [openState, setOpen]);
+
+  return (
+    <>
+      <button
+        type="button"
+        aria-label={m['docs.search_label']()}
+        onClick={() => setOpen(true)}
+        className="text-muted-foreground hover:text-foreground border-border hover:border-foreground/30 flex w-full items-center gap-2 rounded-lg border bg-transparent px-2.5 py-1.5 text-sm transition-colors"
+      >
+        <Search className="size-4 shrink-0" aria-hidden />
+        <span className="truncate">{m['docs.search_placeholder']()}</span>
+        <kbd className="text-muted-foreground bg-muted ml-auto shrink-0 rounded border px-1 font-mono text-[10px]">
+          ⌘K
+        </kbd>
+      </button>
+
+      <Dialog open={openState} onOpenChange={setOpen}>
+        <DialogContent className="max-w-xl gap-0 p-0" showCloseButton={false}>
+          <DialogTitle className="sr-only">
+            {m['docs.search_label']()}
+          </DialogTitle>
+          <DialogDescription className="sr-only">
+            {m['docs.search_placeholder']()}
+          </DialogDescription>
+
+          <div className="border-border flex items-center gap-2 border-b px-3">
+            <Search
+              className="text-muted-foreground size-4 shrink-0"
+              aria-hidden
+            />
+            <Input
+              autoFocus
+              aria-label={m['docs.search_placeholder']()}
+              placeholder={m['docs.search_placeholder']()}
+              value={query}
+              onChange={(event) => setQuery(event.target.value)}
+              className="h-11 border-none focus-visible:ring-0"
+            />
+          </div>
+
+          <div className="max-h-[60vh] overflow-y-auto p-2">
+            {!hasQuery ? (
+              <p className="text-muted-foreground px-3 py-6 text-center text-sm">
+                {m['docs.search_hint']()}
+              </p>
+            ) : results.length === 0 ? (
+              <p className="text-muted-foreground px-3 py-6 text-center text-sm">
+                {m['docs.search_empty']()}
+              </p>
+            ) : (
+              <ul className="space-y-1">
+                {results.map((result) => (
+                  <li key={result.doc.slug}>
+                    <SearchResult
+                      result={result}
+                      onSelect={() => setOpen(false)}
+                    />
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
+
+function SearchResult({
+  result,
+  onSelect,
+}: {
+  result: DocSearchResult;
+  onSelect: () => void;
+}) {
+  const { doc, sections, keyword } = result;
+  const Icon = DOC_ICON[doc.slug] ?? DOC_FALLBACK_ICON;
+
+  return (
+    <div className="rounded-md">
+      <Link
+        to="/docs/$slug"
+        params={{ slug: doc.slug }}
+        onClick={onSelect}
+        className="group hover:bg-muted flex items-center gap-3 rounded-md px-3 py-2.5 transition-colors"
+      >
+        <span className="text-muted-foreground group-hover:text-foreground border-border bg-muted/50 flex size-8 shrink-0 items-center justify-center rounded-md border">
+          <Icon className="size-4" aria-hidden />
+        </span>
+        <span className="min-w-0 flex-1">
+          <span className="block truncate text-sm font-medium">
+            <Highlight text={doc.title} keyword={keyword} />
+          </span>
+          <span className="text-muted-foreground block truncate text-xs">
+            <Highlight text={doc.description} keyword={keyword} />
+          </span>
+        </span>
+      </Link>
+      {sections.length > 0 && (
+        <ul className="border-border mt-0.5 mb-1 ml-[3.25rem] space-y-0.5 border-l pl-2">
+          {sections.map((section) => (
+            // The section without a heading (the intro) has no id and appears
+            // at most once, so a fixed key is enough.
+            <li key={section.id === '' ? 'intro' : section.id}>
+              {section.text === '' ? (
+                <p className="text-muted-foreground py-1 text-xs">
+                  <Highlight text={section.snippet} keyword={keyword} />
+                </p>
+              ) : (
+                <SectionLink
+                  slug={doc.slug}
+                  section={section}
+                  keyword={keyword}
+                  onSelect={onSelect}
+                />
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+function SectionLink({
+  slug,
+  section,
+  keyword,
+  onSelect,
+}: {
+  slug: string;
+  section: { id: string; text: string; level: 2 | 3; snippet: string };
+  keyword: string;
+  onSelect: () => void;
+}) {
+  return (
+    <Link
+      to="/docs/$slug"
+      params={{ slug }}
+      hash={section.id}
+      onClick={onSelect}
+      className={`hover:bg-muted hover:text-foreground text-muted-foreground block rounded px-2 py-1 text-xs transition-colors ${
+        section.level === 3 ? 'pl-5' : ''
+      }`}
+    >
+      <span className="flex items-center gap-1.5">
+        {section.level === 3 && (
+          <CornerDownRight className="size-3 shrink-0 opacity-60" aria-hidden />
+        )}
+        <span className="truncate font-medium">
+          <Highlight text={section.text} keyword={keyword} />
+        </span>
+      </span>
+      {section.snippet !== '' && (
+        <span className="mt-0.5 block truncate opacity-80">
+          <Highlight text={section.snippet} keyword={keyword} />
+        </span>
+      )}
+    </Link>
+  );
+}
+
+/**
+ * Wrap the matched part of a text in `<mark>`. The match is
+ * case-insensitive, the original casing is kept.
+ */
+function Highlight({ text, keyword }: { text: string; keyword: string }) {
+  if (keyword === '') return <>{text}</>;
+
+  const lowerText = text.toLowerCase();
+  const lowerKeyword = keyword.toLowerCase();
+  const parts: ReactNode[] = [];
+
+  let cursor = 0;
+  let at = lowerText.indexOf(lowerKeyword);
+  while (at !== -1) {
+    if (at > cursor) parts.push(text.slice(cursor, at));
+    parts.push(
+      <mark key={at} className="bg-primary/20 rounded-sm px-0.5 text-inherit">
+        {text.slice(at, at + keyword.length)}
+      </mark>
+    );
+    cursor = at + keyword.length;
+    at = lowerText.indexOf(lowerKeyword, cursor);
+  }
+
+  if (parts.length === 0) return <>{text}</>;
+  parts.push(text.slice(cursor));
+  return <>{parts}</>;
+}
diff --git a/src/components/docs/DocsSidebar.tsx b/src/components/docs/DocsSidebar.tsx
new file mode 100644
index 0000000..7a439d0
--- /dev/null
+++ b/src/components/docs/DocsSidebar.tsx
@@ -0,0 +1,179 @@
+'use client';
+
+import { useEffect, useMemo, useState } from 'react';
+import { Link } from '@tanstack/react-router';
+import { ChevronRight } from 'lucide-react';
+
+import { groupDocs, type DocEntry, type DocGroup } from '@/modules/docs/paths';
+import { m } from '@/paraglide/messages.js';
+import { DOC_FALLBACK_ICON, DOC_ICON } from '@/components/docs/doc-icons';
+
+/**
+ * Documentation navigation.
+ *
+ * Documents are grouped by the `group` frontmatter key; a group heading can
+ * be collapsed. Only the groups the visitor collapsed themselves stay
+ * collapsed — a group that holds the current document is always open, so a
+ * jump from the search results never hides the active entry.
+ */
+export function DocsSidebar({
+  docs,
+  activeSlug,
+  onNavigate,
+}: {
+  docs: DocEntry[];
+  /** The slug of the document being read; its group is expanded. */
+  activeSlug?: string;
+  /** Called after a link was followed (closes the mobile drawer). */
+  onNavigate?: () => void;
+}) {
+  const groups = groupDocs(docs);
+
+  const [collapsed, setCollapsed] = useState<ReadonlySet<string>>(new Set());
+
+  const activeGroup = useMemo(
+    () =>
+      groups.find((group) => group.items.some((doc) => doc.slug === activeSlug))
+        ?.title,
+    [groups, activeSlug]
+  );
+
+  useEffect(() => {
+    if (activeGroup === undefined) return;
+    setCollapsed((previous) => {
+      if (!previous.has(activeGroup)) return previous;
+      const next = new Set(previous);
+      next.delete(activeGroup);
+      return next;
+    });
+  }, [activeGroup]);
+
+  function toggleGroup(title: string) {
+    setCollapsed((previous) => {
+      const next = new Set(previous);
+      if (next.has(title)) next.delete(title);
+      else next.add(title);
+      return next;
+    });
+  }
+
+  if (groups.length === 0) {
+    return (
+      <p className="text-muted-foreground px-2 py-4 text-sm">
+        {m['docs.empty']()}
+      </p>
+    );
+  }
+
+  return (
+    <nav className="text-sm" aria-label={m['docs.sidebar_title']()}>
+      {groups.map((group) =>
+        group.title === '' ? (
+          <ul key="__root__" className="mb-4 space-y-0.5">
+            {group.items.map((doc) => (
+              <DocLink
+                key={doc.slug}
+                doc={doc}
+                activeSlug={activeSlug}
+                onNavigate={onNavigate}
+              />
+            ))}
+          </ul>
+        ) : (
+          <DocGroupSection
+            key={group.title}
+            group={group}
+            open={!collapsed.has(group.title)}
+            onToggle={() => toggleGroup(group.title)}
+            activeSlug={activeSlug}
+            onNavigate={onNavigate}
+          />
+        )
+      )}
+    </nav>
+  );
+}
+
+function DocGroupSection({
+  group,
+  open,
+  onToggle,
+  activeSlug,
+  onNavigate,
+}: {
+  group: DocGroup;
+  open: boolean;
+  onToggle: () => void;
+  activeSlug?: string;
+  onNavigate?: () => void;
+}) {
+  return (
+    <div className="mb-1">
+      <h2>
+        <button
+          type="button"
+          onClick={onToggle}
+          aria-expanded={open}
+          className="group text-foreground hover:text-primary mt-5 flex w-full items-center gap-2 rounded-lg px-2 py-1 text-sm transition-colors"
+        >
+          <span className="truncate">{group.title}</span>
+          <ChevronRight
+            className={`text-muted-foreground ml-auto size-4 shrink-0 transition-transform ${
+              open ? 'rotate-90' : ''
+            }`}
+            aria-hidden
+          />
+        </button>
+      </h2>
+      {open && (
+        <ul className="mt-0.5 space-y-0.5">
+          {group.items.map((doc) => (
+            <DocLink
+              key={doc.slug}
+              doc={doc}
+              activeSlug={activeSlug}
+              onNavigate={onNavigate}
+            />
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+function DocLink({
+  doc,
+  activeSlug,
+  onNavigate,
+}: {
+  doc: DocEntry;
+  activeSlug?: string;
+  onNavigate?: () => void;
+}) {
+  const Icon = DOC_ICON[doc.slug] ?? DOC_FALLBACK_ICON;
+  // The active state is computed here: the index page and the article pages
+  // are different routes, so the router cannot decide it.
+  const isActive = activeSlug === doc.slug;
+
+  const className = [
+    'group flex items-center gap-2 rounded-lg px-2 py-2 text-sm transition-colors hover:bg-muted hover:text-foreground',
+    isActive
+      ? 'bg-sidebar-accent font-medium text-sidebar-accent-foreground'
+      : 'text-muted-foreground',
+  ].join(' ');
+
+  return (
+    <li>
+      <Link
+        to="/docs/$slug"
+        params={{ slug: doc.slug }}
+        onClick={onNavigate}
+        className={className}
+        aria-current={isActive ? 'page' : undefined}
+      >
+        <Icon className="size-4 shrink-0" aria-hidden />
+        <span className="truncate">{doc.title}</span>
+      </Link>
+    </li>
+  );
+}

-    let status = 0;
-    let meaning = 'Network error or request timed out';
-    try {
-      const response = await fetch(endpoint, {
-        method: 'POST',
-        headers: {
-          'Content-Type': 'application/json; charset=utf-8',
-          'User-Agent': `IndexNowClient (+${siteOrigin()})`,
-        },
-        body,
-        redirect: 'error',
-        signal: AbortSignal.timeout(10_000),

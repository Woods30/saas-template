+import { and, eq, inArray, lt } from 'drizzle-orm';
+
+import { db } from '@/core/db';
+import { atomic } from '@/core/db/atomic';
+import { PaymentType } from '@/core/payment/types';
+import { manualPaymentDetail, order } from '@/config/db/schema';
+import { getPricingProduct, type PricingProduct } from '@/config/pricing';
+import { getAllConfigs } from '@/modules/config/service';
+import { getUniSeq, getUuid } from '@/lib/hash';
+
+import { getAccount, listEnabledAccounts, resolveQrImageUrl } from './accounts';
+import {
+  ACTIVE_MANUAL_PAYMENT_STATUSES,
+  FINGERPRINT_MAX,
+  FINGERPRINT_MIN,
+  isUniqueViolation,
+  MANUAL_PAYMENT_PROVIDER,
+  MANUAL_PAYMENT_TTL_MS,
+  ManualPaymentError,
+} from './types';
+
+export type CreateManualOrderInput = {
+  userId: string;
+  userEmail?: string;
+  /** Accepts a catalog product or its id; prices always come from the catalog. */
+  product: PricingProduct | string;
+  accountId?: string;
+  now?: Date;
+};
+
+export type CreatedManualOrder = {
+  orderId: string;
+  orderNo: string;
+  payableAmount: number;
+  currency: 'cny';
+  qrImageUrl: string | null;
+  expiresAt: Date;
+};
+
+function shuffle<T>(values: T[]): T[] {
+  const copy = [...values];
+  for (let i = copy.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [copy[i], copy[j]] = [copy[j], copy[i]];
+  }
+  return copy;
+}
+
+function resolveProduct(
+  product: PricingProduct | string
+): PricingProduct | null {
+  if (typeof product === 'string') return getPricingProduct(product);
+  return getPricingProduct(product.productId) ?? product;
+}
+
+/**
+ * Closes every order on `accountId` whose TTL passed: detail → `expired`,
+ * order → `failed` (the projection in the spec's status table). Returns the
+ * number of detail rows expired; those amounts become allocatable again.
+ */
+export async function expireStaleOrders(
+  accountId: string,
+  now: Date = new Date()
+): Promise<number> {
+  const stale = await db()
+    .select({ orderId: manualPaymentDetail.orderId })
+    .from(manualPaymentDetail)
+    .where(
+      and(
+        eq(manualPaymentDetail.accountId, accountId),
+        eq(manualPaymentDetail.status, 'pending_payment'),
+        lt(manualPaymentDetail.expiresAt, now)
+      )
+    );
+  if (stale.length === 0) return 0;
+
+  const ids = stale.map((row: { orderId: string }) => row.orderId);
+  await atomic((q) => [
+    q
+      .update(manualPaymentDetail)
+      .set({ status: 'expired', updatedAt: new Date() })
+      .where(
+        and(
+          eq(manualPaymentDetail.accountId, accountId),
+          eq(manualPaymentDetail.status, 'pending_payment'),
+          lt(manualPaymentDetail.expiresAt, now)
+        )
+      ),
+    q
+      .update(order)
+      .set({ status: 'failed', updatedAt: new Date() })
+      .where(inArray(order.id, ids)),
+  ]);
+  return ids.length;
+}
+
+/**
+ * Creates a pending manual-payment order: an `order` row plus its 1:1 detail,
+ * priced at the catalog's CNY amount plus a 1–99 fen fingerprint that keeps
+ * live orders on one account distinguishable by amount alone.
+ *
+ * The (accountId, payableAmount) partial unique index is the arbiter: two
+ * concurrent calls that pick the same fingerprint cannot both commit, and the
+ * loser simply moves to the next candidate.
+ */
+export async function createManualOrder(
+  input: CreateManualOrderInput
+): Promise<CreatedManualOrder> {
+  const now = input.now ?? new Date();
+  const configs = await getAllConfigs();
+  if (configs.manual_payments_enabled !== 'true') {
+    throw new ManualPaymentError(
+      'MODULE_DISABLED',
+      'Manual payments are not enabled.'
+    );
+  }
+
+  const product = resolveProduct(input.product);
+  if (
+    !product ||
+    product.type !== PaymentType.ONE_TIME ||
+    !product.cnyPriceInCents
+  ) {
+    throw new ManualPaymentError(
+      'INVALID_OFFER',
+      'Manual payments only sell one-time products with a CNY price.'
+    );
+  }
+
+  const account = input.accountId
+    ? await getAccount(input.accountId)
+    : (await listEnabledAccounts())[0];
+  if (!account || !account.enabled) {
+    throw new ManualPaymentError(
+      'NO_MANUAL_PAYMENT_ACCOUNT',
+      'No enabled collection account.'
+    );
+  }
+
+  // Amounts held by expired orders are free again before allocation.
+  await expireStaleOrders(account.id, now);
+
+  const taken = new Set(
+    (
+      await db()
+        .select({ payableAmount: manualPaymentDetail.payableAmount })
+        .from(manualPaymentDetail)
+        .where(
+          and(
+            eq(manualPaymentDetail.accountId, account.id),
+            inArray(manualPaymentDetail.status, [
+              ...ACTIVE_MANUAL_PAYMENT_STATUSES,
+            ])
+          )
+        )
+    ).map((row: { payableAmount: number }) => row.payableAmount)
+  );
+
+  const baseAmount = product.cnyPriceInCents;
+  const candidates: number[] = [];
+  for (
+    let fingerprint = FINGERPRINT_MIN;
+    fingerprint <= FINGERPRINT_MAX;
+    fingerprint++
+  ) {
+    if (!taken.has(baseAmount + fingerprint)) candidates.push(fingerprint);
+  }
+  if (candidates.length === 0) {
+    throw new ManualPaymentError(
+      'AMOUNT_POOL_EXHAUSTED',
+      'Every amount on this account is already in use.'
+    );
+  }
+
+  const expiresAt = new Date(now.getTime() + MANUAL_PAYMENT_TTL_MS);
+  const qrImageUrl = await resolveQrImageUrl(account.qrImageKey);
+
+  for (const fingerprint of shuffle(candidates)) {
+    const orderId = getUuid();
+    const orderNo = getUniSeq('ORD');
+    const payableAmount = baseAmount + fingerprint;
+    try {
+      await atomic((q) => [
+        q.insert(order).values({
+          id: orderId,
+          orderNo,
+          userId: input.userId,
+          userEmail: input.userEmail || '',
+          // Spec §8.2: pending_payment projects to the order status `created`.
+          status: 'created',
+          amount: payableAmount,
+          currency: 'cny',
+          productId: product.productId,
+          productName: product.productName,
+          planName: product.planName,
+          description: product.description,
+          // What the settlement path grants once the receipt is approved.
+          creditsAmount: product.credits || null,
+          creditsValidDays: product.creditsValidDays || null,
+          paymentType: 'one-time',
+          paymentProvider: MANUAL_PAYMENT_PROVIDER,
+          checkoutInfo: JSON.stringify({
+            productId: product.productId,
+            accountId: account.id,
+          }),
+        }),
+        q.insert(manualPaymentDetail).values({
+          orderId,
+          userId: input.userId,
+          accountId: account.id,
+          fingerprint,
+          baseAmount,
+          payableAmount,
+          currency: 'cny',
+          status: 'pending_payment',
+          expiresAt,
+        }),
+      ]);
+      return {
+        orderId,
+        orderNo,
+        payableAmount,
+        currency: 'cny',
+        qrImageUrl,
+        expiresAt,
+      };
+    } catch (error) {
+      // Lost the race for this amount: try the next candidate.
+      if (isUniqueViolation(error)) continue;
+      throw error;
+    }
+  }
+
+  throw new ManualPaymentError(
+    'AMOUNT_POOL_EXHAUSTED',
+    'Every amount on this account is already in use.'
+  );
+}
diff --git a/src/modules/manual-payments/receipts.ts b/src/modules/manual-payments/receipts.ts
new file mode 100644
index 0000000..97294d0
--- /dev/null
+++ b/src/modules/manual-payments/receipts.ts
@@ -0,0 +1,190 @@
+import { and, eq } from 'drizzle-orm';
+
+import { db } from '@/core/db';
+import { atomic } from '@/core/db/atomic';
+import {
+  contentTypeFromKey,
+  LocalPrivateProvider,
+  type StorageObject,
+} from '@/core/storage';
+import { manualPaymentDetail, order } from '@/config/db/schema';
+import {
+  getUserPermissionCodes,
+  isAdminPermission,
+} from '@/modules/rbac/service';
+import { getStorage } from '@/modules/storage/service';
+import { getUuid } from '@/lib/hash';
+
+import { ManualPaymentError } from './types';
+
+/** Cap for one receipt image. Same limit as the public image upload route. */
+export const MAX_RECEIPT_BYTES = 10 * 1024 * 1024;
+
+/**
+ * Raster formats only — SVG is refused because it can carry script and would
+ * run on whatever origin serves it.
+ */
+const RECEIPT_MIME_EXT: Record<string, string> = {
+  'image/jpeg': 'jpg',
+  'image/jpg': 'jpg',
+  'image/png': 'png',
+  'image/webp': 'webp',
+  'image/gif': 'gif',
+  'image/avif': 'avif',
+  'image/heic': 'heic',
+  'image/heif': 'heif',
+};
+
+/** Receipts live under their own private prefix, never a public one. */
+export function receiptKeyFor(orderId: string, ext: string): string {
+  return `manual-receipts/${orderId}/${getUuid()}.${ext}`;
+}
+
+/**
+ * Writes an object to private storage: R2 when configured, otherwise the
+ * local-disk provider under `data/uploads/` — never `public/`.
+ */
+export async function putPrivateObject(input: {
+  key: string;
+  body: Uint8Array;
+  contentType: string;
+}): Promise<void> {
+  const storage = await getStorage();
+  const provider = storage ?? new LocalPrivateProvider();
+  const result = await provider.uploadFile({
+    key: input.key,
+    body: input.body,
+    contentType: input.contentType,
+  });
+  if (!result.success) {
+    throw new Error(result.error || 'Receipt upload failed');
+  }
+}
+
+export async function readPrivateObject(
+  key: string
+): Promise<StorageObject | null> {
+  const storage = await getStorage();
+  if (storage) return storage.getObject({ key });
+  return new LocalPrivateProvider().getObject({ key });
+}
+
+async function findDetailByOrderNo(orderNo: string) {
+  const [row] = await db()
+    .select({
+      detail: manualPaymentDetail,
+      orderId: order.id,
+      orderStatus: order.status,
+    })
+    .from(order)
+    .innerJoin(manualPaymentDetail, eq(manualPaymentDetail.orderId, order.id))
+    .where(eq(order.orderNo, orderNo));
+  return row ?? null;
+}
+
+/**
+ * Attaches a payer's receipt to their own order. Refuses anything that is not
+ * a raster image within `MAX_RECEIPT_BYTES`, and only accepts orders that are
+ * still waiting for payment (an expired order cannot be revived).
+ */
+export async function submitReceipt(input: {
+  orderNo: string;
+  userId: string;
+  file: File;
+  payerNote?: string;
+  now?: Date;
+}): Promise<{ receiptKey: string }> {
+  const now = input.now ?? new Date();
+  const ext = RECEIPT_MIME_EXT[input.file.type];
+  if (!ext) {
+    throw new ManualPaymentError(
+      'RECEIPT_REQUIRED',
+      'Receipt must be a raster image (jpg, png, webp, gif, avif, heic).'
+    );
+  }
+  if (input.file.size <= 0 || input.file.size > MAX_RECEIPT_BYTES) {
+    throw new ManualPaymentError(
+      'RECEIPT_REQUIRED',
+      'Receipt must be between 1 byte and 10MB.'
+    );
+  }
+
+  const found = await findDetailByOrderNo(input.orderNo);
+  // Someone else's order is indistinguishable from one that does not exist.
+  if (!found || found.detail.userId !== input.userId) {
+    throw new ManualPaymentError('ORDER_NOT_FOUND', 'Order not found.');
+  }
+  if (
+    found.detail.status !== 'pending_payment' ||
+    found.detail.expiresAt.getTime() <= now.getTime()
+  ) {
+    throw new ManualPaymentError(
+      'ORDER_NOT_PAYABLE',
+      'This order is no longer waiting for payment.'
+    );
+  }
+
+  const body = new Uint8Array(await input.file.arrayBuffer());
+  const receiptKey = receiptKeyFor(found.orderId, ext);
+  await putPrivateObject({
+    key: receiptKey,
+    body,
+    contentType: input.file.type,
+  });
+
+  const payerNote = input.payerNote?.trim() || null;
+  await atomic((q) => [
+    q
+      .update(manualPaymentDetail)
+      .set({
+        status: 'pending_verification',
+        receiptKey,
+        payerNote,
+        submittedAt: now,
+        updatedAt: now,
+      })
+      // Only from pending_payment: a second concurrent upload, or an expiry
+      // that raced the read above, must not overwrite the first receipt.
+      .where(
+        and(
+          eq(manualPaymentDetail.orderId, found.orderId),
+          eq(manualPaymentDetail.status, 'pending_payment')
+        )
+      ),
+    q
+      .update(order)
+      .set({ status: 'pending', updatedAt: now })
+      .where(eq(order.id, found.orderId)),
+  ]);
+
+  return { receiptKey };
+}
+
+/**
+ * Streams a receipt back to its owner or an admin. Every other case returns
+ * null so the route can answer 404 — a 403 would confirm the order exists.
+ */
+export async function openReceipt(input: {
+  orderNo: string;
+  userId: string;
+  isAdmin: boolean;
+}): Promise<StorageObject | null> {
+  const found = await findDetailByOrderNo(input.orderNo);
+  if (!found || !found.detail.receiptKey) return null;
+  if (!input.isAdmin && found.detail.userId !== input.userId) return null;
+
+  const object = await readPrivateObject(found.detail.receiptKey);
+  if (!object) return null;
+  return {
+    body: object.body,
+    contentType:
+      object.contentType && object.contentType !== 'application/octet-stream'
+        ? object.contentType
+        : contentTypeFromKey(found.detail.receiptKey),
+  };
+}
+/** Whether a user may read any order's receipt (admin panel permission). */
+export async function isManualPaymentAdmin(userId: string): Promise<boolean> {
+  const codes = await getUserPermissionCodes(userId);
+  return codes.some((code) => isAdminPermission(code));
+}
diff --git a/src/modules/manual-payments/review.ts b/src/modules/manual-payments/review.ts
new file mode 100644
index 0000000..b4bd141
--- /dev/null
+++ b/src/modules/manual-payments/review.ts
@@ -0,0 +1,214 @@
+import { and, eq, inArray } from 'drizzle-orm';
+
+import { db } from '@/core/db';
+import { PaymentStatus } from '@/core/payment/types';
+import { manualPaymentDetail, order } from '@/config/db/schema';
+import { settleCheckoutOrder } from '@/modules/payment/service';
+
+import {
+  MANUAL_PAYMENT_PROVIDER,
+  ManualPaymentError,
+  type ManualPaymentStatus,
+} from './types';
+
+export type ReviewAction = 'approve' | 'approve_exception' | 'reject';
+
+async function loadByOrderNo(orderNo: string) {
+  const [row] = await db()
+    .select({ order: order, detail: manualPaymentDetail })
+    .from(order)
+    .innerJoin(manualPaymentDetail, eq(manualPaymentDetail.orderId, order.id))
+    .where(eq(order.orderNo, orderNo));
+  if (!row) throw new ManualPaymentError('ORDER_NOT_FOUND', 'Order not found.');
+  return row;
+}
+
+function isExpired(
+  detail: typeof manualPaymentDetail.$inferSelect,
+  now: Date
+): boolean {
+  return (
+    detail.status === 'expired' ||
+    (detail.status === 'pending_payment' &&
+      detail.expiresAt.getTime() <= now.getTime())
+  );
+}
+
+/**
+ * Approves or rejects a manual payment.
+ *
+ * `approve` settles a live order through the same code path as an automated
+ * provider (one atomic claim → at most one credit grant). `approve_exception`
+ * is for money that arrived after the order expired; it revives the order
+ * first and is the only action allowed to settle an expired one. `reject`
+ * closes the order as failed without granting anything.
+ */
+export async function reviewManualOrder(input: {
+  orderNo: string;
+  action: ReviewAction;
+  reviewerId: string;
+  observedAmount?: number;
+  externalReference?: string;
+  reviewNote?: string;
+}): Promise<void> {
+  const now = new Date();
+  const { order: existingOrder, detail } = await loadByOrderNo(input.orderNo);
+
+  if (input.action === 'reject') {
+    if (
+      detail.status !== 'pending_verification' &&
+      detail.status !== 'pending_payment'
+    ) {
+      throw new ManualPaymentError(
+        'INVALID_TRANSITION',
+        `Cannot reject an order in status ${detail.status}.`
+      );
+    }
+    await db()
+      .update(manualPaymentDetail)
+      .set({
+        status: 'rejected',
+        reviewNote: input.reviewNote?.trim() || null,
+        reviewedBy: input.reviewerId,
+        reviewedAt: now,
+        updatedAt: now,
+      })
+      .where(
+        and(
+          eq(manualPaymentDetail.orderId, existingOrder.id),
+          inArray(manualPaymentDetail.status, [
+            'pending_verification',
+            'pending_payment',
+          ])
+        )
+      );
+    await db()
+      .update(order)
+      .set({ status: 'failed', updatedAt: now })
+      .where(
+        and(
+          eq(order.id, existingOrder.id),
+          inArray(order.status, ['created', 'pending'])
+        )
+      );
+    return;
+  }
+
+  const expired = isExpired(detail, now);
+  // A normal approval only settles a live order; expired money needs the
+  // explicit exception so a late transfer is a deliberate call.
+  if (input.action === 'approve' && expired) {
+    throw new ManualPaymentError(
+      'ORDER_NOT_PAYABLE',
+      'This order has expired; use approve_exception to settle it.'
+    );
+  }
+  if (
+    !expired &&
+    detail.status !== 'pending_verification' &&
+    detail.status !== 'pending_payment'
+  ) {
+    throw new ManualPaymentError(
+      'INVALID_TRANSITION',
+      `Cannot approve an order in status ${detail.status}.`
+    );
+  }
+
+  // The operator names the amount they saw land. Anything but the exact
+  // payable amount is refused — a near match is the likeliest human error.
+  const observedAmount = input.observedAmount ?? detail.payableAmount;
+  if (observedAmount !== detail.payableAmount) {
+    throw new ManualPaymentError(
+      'AMOUNT_MISMATCH',
+      `Observed ${observedAmount} does not match payable ${detail.payableAmount}.`
+    );
+  }
+
+  // Expired orders may already be projected to `failed`; bring them back to a
+  // settleable state before the shared settlement path sees them.
+  if (!['created', 'pending'].includes(existingOrder.status)) {
+    if (input.action !== 'approve_exception') {
+      throw new ManualPaymentError(
+        'ORDER_NOT_PAYABLE',
+        `Order status is ${existingOrder.status}.`
+      );
+    }
+    await db()
+      .update(order)
+      .set({ status: 'pending', updatedAt: now })
+      .where(
+        and(
+          eq(order.id, existingOrder.id),
+          inArray(order.status, ['created', 'failed'])
+        )
+      );
+  }
+
+  const transactionId =
+    input.externalReference?.trim() || `manual_${existingOrder.orderNo}`;
+  const settledStatus: ManualPaymentStatus = 'settled';
+
+  const { order: settledOrder } = await loadByOrderNo(input.orderNo);
+  await settleCheckoutOrder(
+    settledOrder,
+    {
+      paymentStatus: PaymentStatus.SUCCESS,
+      paymentInfo: {
+        transactionId,
+        amount: observedAmount,
+        currency: 'cny',
+        paidAt: now,
+        paymentAmount: observedAmount,
+        paymentCurrency: 'cny',
+      },
+      paymentResult: { provider: MANUAL_PAYMENT_PROVIDER, transactionId },
+    },
+    MANUAL_PAYMENT_PROVIDER,
+    (q) => [
+      // Same commit as the order/credit writes: the detail can never say
+      // "settled" for an order that is not paid, or the reverse.
+      q
+        .update(manualPaymentDetail)
+        .set({
+          status: settledStatus,
+          observedAmount,
+          externalReference: input.externalReference?.trim() || null,
+          reviewNote: input.reviewNote?.trim() || null,
+          reviewedBy: input.reviewerId,
+          reviewedAt: now,
+          settledAt: now,
+          updatedAt: now,
+        })
+        .where(eq(manualPaymentDetail.orderId, existingOrder.id)),
+    ]
+  );
+
+  const [after] = await db()
+    .select({ status: order.status })
+    .from(order)
+    .where(eq(order.id, existingOrder.id));
+  if (after?.status !== 'paid') {
+    throw new ManualPaymentError(
+      'INVALID_TRANSITION',
+      'Order was settled by another request.'
+    );
+  }
+}
+
+/**
+ * Refunds a settled manual order. There is no channel to call — the money
+ * moves outside the app — so this is the shared refund bookkeeping (status,
+ * credit rollback) plus closing the detail row as `canceled`.
+ */
+export async function refundManualOrder(input: {
+  orderNo: string;
+  operatorId: string;
+  reviewNote?: string;
+}): Promise<void> {
+  const { refundOrder } = await import('@/modules/payment/service');
+  await refundOrder({
+    orderNo: input.orderNo,
+    operatorId: input.operatorId,
+    reason: input.reviewNote,
+  });
+}

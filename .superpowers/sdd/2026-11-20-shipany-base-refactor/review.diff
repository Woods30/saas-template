-  const body = JSON.stringify({
-    host: new URL(siteOrigin()).host,
-    key,
-    keyLocation: keyFileUrl(key),
-    urlList: list,
-  });
-  const attempts: IndexNowSubmitResult['results'][number]['attempts'] = [];

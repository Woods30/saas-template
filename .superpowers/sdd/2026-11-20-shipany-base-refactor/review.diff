new file mode 100644
index 0000000..23b10f3
--- /dev/null
+++ b/scripts/check-deploy-env.mjs
@@ -0,0 +1,55 @@
+#!/usr/bin/env node
+/**
+ * Pre-deploy gate: refuse to deploy with a missing or placeholder secret.
+ *
+ * Reads process.env first (CI/Workers/Docker), then falls back to the
+ * dotenv files the app itself loads: .env.production, then .env.
+ */
+import { readFileSync } from 'node:fs';
+
+const PLACEHOLDER = 'development-secret-change-in-production';
+
+function readEnvFile(path) {
+  try {
+    const text = readFileSync(path, 'utf8');
+    const values = {};
+    for (const line of text.split('\n')) {
+      const match = /^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/.exec(line);
+      if (!match) continue;
+      values[match[1]] = match[2].replace(/^['"]|['"]$/g, '');
+    }
+    return values;
+  } catch {
+    return {};
+  }
+}
+
+const fileEnv = {
+  ...readEnvFile('.env'),
+  ...readEnvFile('.env.production'),
+};
+const env = { ...fileEnv, ...process.env };
+
+const failures = [];
+
+const authSecret = (env.AUTH_SECRET ?? '').trim();
+if (!authSecret) failures.push('AUTH_SECRET is missing.');
+else if (authSecret === PLACEHOLDER)
+  failures.push('AUTH_SECRET is still the development placeholder.');
+
+const encryptionKey = (env.CONFIG_ENCRYPTION_KEY ?? '').trim();
+if (!encryptionKey)
+  failures.push(
+    'CONFIG_ENCRYPTION_KEY is missing — secrets stored in the config table would be unreadable after this deploy.'
+  );
+else if (encryptionKey.length < 32)
+  failures.push('CONFIG_ENCRYPTION_KEY must be at least 32 characters.');
+
+if (failures.length > 0) {
+  console.error(
+    'Refusing to deploy:\n' + failures.map((f) => `  - ${f}`).join('\n')
+  );
+  process.exit(1);
+}
+
+console.log('Deploy env check passed.');
diff --git a/scripts/check-wrangler-config.mjs b/scripts/check-wrangler-config.mjs
new file mode 100644
index 0000000..0f67910
--- /dev/null
+++ b/scripts/check-wrangler-config.mjs
@@ -0,0 +1,42 @@
+#!/usr/bin/env node
+// Check the Cloudflare working config before a build.
+//
+// The nitro cloudflare preset reads wrangler.jsonc with JSON.parse, so the
+// file has to be plain JSON: no `//` comments and no trailing commas — even
+// though wrangler itself accepts both. This turns a cryptic nitro build
+// error into a message that says what to do.
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+
+const root = process.cwd();
+
+// nitro looks for wrangler.json first, then wrangler.jsonc.
+const candidates = ['wrangler.json', 'wrangler.jsonc'];
+const path = candidates
+  .map((name) => resolve(root, name))
+  .find((candidate) => existsSync(candidate));
+
+if (path === undefined) {
+  console.log(
+    '[check-wrangler-config] no wrangler.json / wrangler.jsonc — skipping (Node-only deploy).'
+  );
+  process.exit(0);
+}
+
+const raw = readFileSync(path, 'utf8');
+
+try {
+  JSON.parse(raw);
+} catch (error) {
+  console.error(`[check-wrangler-config] ${path} is not valid JSON.`);
+  console.error(
+    '  The cloudflare build parses it with JSON.parse: comments (//) and trailing commas break it.'
+  );
+  console.error(
+    '  Start from wrangler.example.jsonc and fill in the values without adding comments.'
+  );
+  console.error(`  ${error instanceof Error ? error.message : String(error)}`);
+  process.exit(1);
+}
+
+console.log(`[check-wrangler-config] ${path} is valid JSON.`);

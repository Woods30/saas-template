+    orderNo: created.orderNo,
+    userId: 'u-reject',
+    file: pngFile(),
+  });
+
+  await reviewManualOrder({
+    orderNo: created.orderNo,
+    action: 'reject',
+    reviewerId: 'admin-1',
+    reviewNote: 'screenshot is a different amount',
+  });

{
  "name": "saas-template",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run check:env:prod && pnpm run build && pnpm run check:client-bundle && wrangler deploy",
    "check": "pnpm run locale:compile && biome check . && tsc --noEmit && pnpm run check:env && pnpm run locale:check",
    "check:env": "tsx scripts/check-env.ts",
    "check:env:prod": "pnpm run locale:compile && tsx scripts/check-env-prod.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "check:locale": "pnpm run locale:compile && pnpm run locale:check",
    "locale:compile": "tsx scripts/locale-compile.ts",
    "locale:sort": "tsx scripts/locale-sort.ts",
    "locale:check": "tsx scripts/check-locale.ts",
    "typecheck": "pnpm run locale:compile && tsc --noEmit",
    "test": "pnpm run locale:compile && vitest run",
    "test:affected": "pnpm run locale:compile && vitest run --changed",
    "check:core": "tsx scripts/check-core-changed.ts",
    "test:watch": "pnpm run locale:compile && vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts --passWithNoTests",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.local.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio:local": "drizzle-kit studio --config=drizzle.config.local.ts",
    "db:studio:remote": "drizzle-kit studio --config=drizzle.config.ts",
    "db:admin:local": "tsx scripts/set-admin.ts --local",
    "db:admin:remote": "tsx scripts/set-admin.ts --remote",
    "setup": "tsx scripts/setup.ts",
    "content:build": "content-collections build && tsx scripts/normalize-content-collections.ts",
    "email:dev": "email dev --dir src/mail/templates --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "^1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@inquirer/prompts": "^8.7.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "inquirer": "^14.2.3",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.8.0",
    "resend": "^6.32.1",
    "shiki": "^4.5.0",
    "stripe": "^23.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@content-collections/cli": "^0.1.9",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "4.5.2",
    "@playwright/test": "^1.64.0",
    "@react-email/ui": "6.11.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}

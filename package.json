{
  "name": "saas-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run check:env:prod && pnpm run build && pnpm run check:client-bundle && wrangler deploy",
    "check": "pnpm run locale:compile && biome check . && tsc --noEmit && pnpm run check:env && pnpm run locale:check",
    "check:env": "tsx scripts/check-env.ts",
    "check:env:prod": "tsx scripts/check-env-prod.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "check:locale": "pnpm run locale:compile && pnpm run locale:check",
    "locale:compile": "paraglide-js compile --project ./project.inlang",
    "locale:sort": "tsx scripts/locale-sort.ts",
    "locale:check": "tsx scripts/check-locale.ts",
    "typecheck": "pnpm run locale:compile && tsc --noEmit",
    "test": "pnpm run locale:compile && vitest run",
    "test:watch": "pnpm run locale:compile && vitest",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@inquirer/prompts": "^8.7.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "inquirer": "^14.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "resend": "^6.32.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "4.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}

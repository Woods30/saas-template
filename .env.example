# 开发用环境变量：cp .env.example .env；按已启用模块补齐配置。
# 当前 mail.enabled=true（resend）、auth.requireEmailVerification=true，邮件配置不可留空：
# 缺失会使 auth incomplete，/api/auth/* 返回 503，生产校验失败，不会隐式关闭邮箱验证。
# 生产另建 `.env.production`（不得入库），`pnpm deploy` 与 `vite build` 读它。
# 详见 content/docs/environment.zh.md 与 content/docs/cloudflare.zh.md。

# Site
# 生产部署必须改为实际域名，否则 SEO / OG 全部指向 localhost。
VITE_BASE_URL=http://localhost:3000

# 模块与能力开关（可选，逗号分隔的白名单）
# 留空即不覆盖，沿用 `src/config/website.ts` 里的默认值。
# 给了白名单就只开名单里的模块：文档站用 `docs`，业务站留空。
VITE_MODULES=
VITE_FEATURES=
# 本仓就是文档站时置 true：根路径直接进文档首页，而不是营销首页。
VITE_DOCS_AS_HOME=

# Payment
# 选 `stripe` 或 `creem`；留空沿用 `src/config/website.ts` 的默认值。
VITE_PAYMENT_PROVIDER=
# 产品与付费方式写在 `src/config/products.ts`，这里只放凭据。
# 只校验当前 provider 的变量：选了 creem，Stripe 的 key 留空不影响诊断。

# Checkout mode · 核销型支付
# 新订单走哪条结账链路：`provider` 走托管支付渠道，`collection` 走收款码核销。
# 两条链路互斥，同一时刻只有一条收新订单；留空沿用源码默认值 `provider`。
# 用 `collection` 时还要在 `src/config/website.ts` 启用 `collection` 模块并配置收款账户。
VITE_CHECKOUT_MODE=
# 核销型支付的收款账户清单（JSON 数组），覆盖 `src/config/website.ts` 的源码兜底：
# 不碰源码也能配收款账户。形状：[{"id":"alipay-1","channel":"alipay",
# "displayName":"支付宝个人收款","currency":"cny","qrImageUrl":"/collection/qr.png"}]。
# 二维码地址必须是站内根路径或无凭据 HTTPS。非法值整体忽略并回退源码配置。
VITE_COLLECTION_ACCOUNTS=

# Stripe · https://docs.stripe.com/keys
# 右侧引用填 Price 的 `lookup_key`（不是 Price ID）：展示价从 Stripe 实时取，
# 换价时把 key 迁到新 Price 上即可，页面与代码都不用改。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Creem · https://docs.creem.io
# 引用 → Creem 商品 ID（`prod_*`）的映射，逗号分隔。Creem 没有 lookup_key，
# 商品本身就是价格，所以映射放在部署环境而不是代码里。
# 例：CREEM_PRODUCTS=pro_monthly=prod_xxx,pro_yearly=prod_yyy,lifetime=prod_zzz
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCTS=
# true 时打 Creem 沙箱（test-api.creem.io），用沙箱 key 联调。
CREEM_DEBUG=

# Auth · https://www.better-auth.com/docs/reference/options
# secret 用 `openssl rand -base64 32` 生成。
BETTER_AUTH_SECRET=
# 回调与重定向的绝对 URL 基址。当前邮箱验证开启，必须显式设置并与 VITE_BASE_URL 一致。
# 生产改为实际 HTTPS origin；Release 部署默认从 VITE_BASE_URL 取值。
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare · binding 声明在 wrangler.jsonc
# 生产真实值不要写进本文件；Release 从 GitHub production Environment 同步运行时白名单。
# 手工部署须确保 .env.production 校验值与 Worker 运行时绑定一致，可用 `wrangler secret put`。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL_SENDER=
# 远端 D1 的 ID：drizzle-kit 走 d1-http 驱动连生产库时需要（drizzle.config.ts 直接读
# process.env，不走 src/env 的两层校验）。`pnpm run setup` 会写入；换账号必须重新生成，
# 否则连的是别人的库。
CLOUDFLARE_DATABASE_ID=
# 本地 SQLite 文件路径：drizzle-kit 本地模式用（drizzle.config.local.ts）。
# 留空则用默认的 file:./src/db/migrations/dev.db。
DATABASE_URL=

# Email · https://resend.com/docs/api-reference/introduction
# 当前 Resend 已启用。先在 Resend 添加自己的发信域名并按其要求配置 DNS、完成验证。
# 本地 .env 填真实值；production Environment 中配置 Secret RESEND_API_KEY、Variable MAIL_FROM。
# deploy.yml 已映射并通过 --secrets-file 白名单上传；MAIL_FROM 也兼容同名 Secret，Variable 优先。
# 两者均不加 VITE_ 前缀，不能进入客户端 bundle；手工生产部署须同步运行时绑定。
RESEND_API_KEY=
# 已验证域名下的纯邮件地址，例如 noreply@example.com；不接受 Brand <noreply@example.com>。
# 发件地址与 src/config/website.ts 的 mail.supportEmail（支持收件邮箱）独立，不会自动互填。
# 支持邮箱已在 website.ts 配置；发件地址仍须单独提供，不能直接推断支持邮箱可用于 Resend 发信。
MAIL_FROM=

# Newsletter · https://developers.beehiiv.com/welcome/create-an-api-key
RESEND_AUDIENCE_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_SEND_WELCOME_EMAIL=

# Notification
DISCORD_WEBHOOK_URL=
# 飞书自定义机器人
FEISHU_WEBHOOK_URL=

# Analytics（任填启用）
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
# 兼容旧写法：VITE_UMAMI_WEBSITE_ID 未设时回退到它；两个都留空即未启用。
VITE_UMAMI_ID=
# 必须为无凭据的 HTTPS URL
VITE_UMAMI_SCRIPT_URL=
VITE_CLARITY_PROJECT_ID=
# 兼容旧写法：VITE_CLARITY_PROJECT_ID 未设时回退到它。
VITE_CLARITY_ID=

# Captcha · https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin：逗号分隔的收件人白名单，用于 /api/email
ADMIN_EMAILS=

# Runtime
NODE_ENV=development

# 环境变量样例：cp .env.example .env
#
# 分两层：
# 1) **启动必需**——没有它站点起不来，或会把自己锁在门外。运行期只读这里。
# 2) **种子初值**——支付 / 邮件 / 通知 / 分析的凭据与公开参数。它们只在
#    `pnpm db:seed` 时被抄进数据库，之后一律在后台「系统设置」里改；环境变量
#    不再生效。留空的项保持出厂默认值。
#
# 生产另建 `.env.production`（不得入库），`pnpm deploy` 与 `vite build` 读它。
# 详见 content/docs/environment.zh.md 与 content/docs/cloudflare.zh.md。
# 设计背景见 docs/adr/0010-settings-in-database.md。

# ───────────────────────────── 启动必需 ─────────────────────────────

# 站点根地址：SEO / OG / 回调链接都基于它；生产必须改为实际域名。
VITE_BASE_URL=http://localhost:3000

# better-auth 密钥，`openssl rand -base64 32` 生成。生产必填。
BETTER_AUTH_SECRET=
# 回调与重定向的绝对 URL 基址；多域名或接了 OAuth / 邮件验证时必须显式设置。
BETTER_AUTH_URL=http://localhost:3000

# 配置加密口令：`settings` 表里的密钥用它派生 AES-GCM 密钥。
# **必须与数据库分开保管**；丢失等于所有已存凭据不可解，只能重填。
# 缺失时后台拒绝保存含密钥的配置组（公开参数仍可写）。
CONFIG_ENCRYPTION_KEY=

# Database · 选方言
# 决定两件事：运行时连什么库，以及**构建期生成哪份 schema**。
# 改完必须重新跑 `pnpm db:setup`，否则运行期会因方言不匹配直接报错。
# sqlite（默认，本地 SQLite 文件）/ d1（Cloudflare D1）/ postgres（PostgreSQL）
DATABASE_PROVIDER=sqlite
# PostgreSQL 连接串（DATABASE_PROVIDER=postgres 时必填）。
# 跑在 Workers 上时可改用 Hyperdrive binding（见 wrangler.jsonc），那时本项可留空。
DATABASE_URL=
# 本地 SQLite 文件路径（sqlite 时用；drizzle-kit 本地模式也读它）。
SQLITE_DATABASE_URL=

# Cloudflare · binding 声明在 wrangler.jsonc
# 生产真实值不要写进本文件；Release 从 GitHub production Environment 同步。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 远端 D1 的 ID：drizzle-kit 走 d1-http 驱动连生产库时需要（直接读 process.env）。
# 换账号必须重新生成，否则连的是别人的库。
CLOUDFLARE_DATABASE_ID=

# 管理员邮箱白名单，逗号分隔：/api/email 的收件人校验。
ADMIN_EMAILS=

# Runtime
NODE_ENV=development

# ───────────────── 种子初值（`pnpm db:seed` 之后改后台） ─────────────────
# 下面的值只被 `pnpm db:seed` 读取一次：抄进 `settings` 表后就以数据库为准。

# Payment · 选 `stripe` 或 `creem` 在后台「支付」页设置
# Stripe · https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Creem · https://docs.creem.io
# 引用 → Creem 商品 ID 的映射，逗号分隔，例：pro_monthly=prod_xxx,lifetime=prod_zzz
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCTS=
# true 时打 Creem 沙箱（test-api.creem.io）。
CREEM_DEBUG=

# 核销型支付（收款码）
# 收款账户清单（JSON 数组）：{"id":"alipay-default","channel":"alipay","displayName":"支付宝","currency":"cny","qrImageUrl":"/collection/qr.png"}
VITE_COLLECTION_ACCOUNTS=

# Auth · Google 登录（可留空，留空即在后台隐藏该登录方式）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email · https://resend.com/docs/api-reference/introduction
# 发件地址必须是已验证域名下的纯地址，不接受 `Brand <noreply@example.com>`。
MAIL_FROM=
RESEND_API_KEY=
CLOUDFLARE_EMAIL_SENDER=

# Newsletter · https://developers.beehiiv.com/welcome/create-an-api-key
RESEND_AUDIENCE_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_SEND_WELCOME_EMAIL=

# Notification
DISCORD_WEBHOOK_URL=
# 飞书自定义机器人
FEISHU_WEBHOOK_URL=

# Analytics（在后台「分析」页选渠道；这里只给标识）
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
# 必须为无凭据的 HTTPS URL
VITE_UMAMI_SCRIPT_URL=
VITE_CLARITY_PROJECT_ID=

# Captcha · https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
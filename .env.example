# 环境变量示例。复制为 .env 后按需填写：cp .env.example .env
# 所有 optional 字段留空即可通过开发检查（pnpm check:env）；生产部署另需在 Cloudflare 配置 secrets。

# Site
# 生产部署必须改为实际域名，例如 `https://example.com`，否则 SEO/OG 全部指向 localhost
VITE_BASE_URL=http://localhost:3000

# Payment（Stripe）
VITE_PAYMENT_PROVIDER=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL_SENDER=

# Email (alternative)
RESEND_API_KEY=

# Newsletter
RESEND_AUDIENCE_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Notification
DISCORD_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# Analytics（任填启用）
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_ID=
VITE_CLARITY_ID=

# Captcha（可选）
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Runtime
NODE_ENV=development

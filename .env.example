# 开发用环境变量：cp .env.example .env；按已启用模块补齐配置。
# 当前 mail.enabled=true（resend）、auth.requireEmailVerification=true，邮件配置不可留空：
# 缺失会使 auth incomplete，/api/auth/* 返回 503，生产校验失败，不会隐式关闭邮箱验证。
# 生产另建 `.env.production`（不得入库），`pnpm deploy` 与 `vite build` 读它。
# 详见 content/docs/environment.zh.md 与 content/docs/cloudflare.zh.md。

# Site
# 生产部署必须改为实际域名，否则 SEO / OG 全部指向 localhost。
VITE_BASE_URL=http://localhost:3000

# Payment（Stripe）· https://docs.stripe.com/keys
VITE_PAYMENT_PROVIDER=
# Price 的 `lookup_key`（不是 Price ID）写在 `src/config/products.ts` 的产品配置里：
# 定价页的展示价从 Stripe 实时取，换价时把 key 迁到新 Price 上即可，页面与代码都不用改。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth · https://www.better-auth.com/docs/reference/options
# secret 用 `openssl rand -base64 32` 生成。
BETTER_AUTH_SECRET=
# 回调与重定向的绝对 URL 基址。当前邮箱验证开启，必须显式设置并与 VITE_BASE_URL 一致。
# 生产改为实际 HTTPS origin；Release 部署默认从 VITE_BASE_URL 取值。
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare · binding 声明在 wrangler.jsonc
# 生产真实值不要写进本文件；Release 从 GitHub production Environment 同步运行时白名单。
# 手工部署须确保 .env.production 校验值与 Worker 运行时绑定一致，可用 `wrangler secret put`。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL_SENDER=

# Email · https://resend.com/docs/api-reference/introduction
# 当前 Resend 已启用。先在 Resend 添加自己的发信域名并按其要求配置 DNS、完成验证。
# 本地 .env 填真实值；production Environment 中配置 Secret RESEND_API_KEY、Variable MAIL_FROM。
# deploy.yml 已映射并通过 --secrets-file 白名单上传；MAIL_FROM 也兼容同名 Secret，Variable 优先。
# 两者均不加 VITE_ 前缀，不能进入客户端 bundle；手工生产部署须同步运行时绑定。
RESEND_API_KEY=
# 已验证域名下的纯邮件地址，例如 noreply@example.com；不接受 Brand <noreply@example.com>。
# 发件地址与 src/config/website.ts 的 mail.supportEmail（支持收件邮箱）独立，不会自动互填。
# 支持邮箱已在 website.ts 配置；发件地址仍须单独提供，不能直接推断支持邮箱可用于 Resend 发信。
MAIL_FROM=

# Newsletter · https://developers.beehiiv.com/welcome/create-an-api-key
RESEND_AUDIENCE_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_SEND_WELCOME_EMAIL=

# Notification
DISCORD_WEBHOOK_URL=
# 飞书自定义机器人
FEISHU_WEBHOOK_URL=

# Analytics（任填启用）
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
# 必须为无凭据的 HTTPS URL
VITE_UMAMI_SCRIPT_URL=
VITE_CLARITY_PROJECT_ID=

# Captcha · https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin：逗号分隔的收件人白名单，用于 /api/email
ADMIN_EMAILS=

# Runtime
NODE_ENV=development

# 开发用环境变量：cp .env.example .env。optional 字段留空即可通过 `pnpm check:env`。
# 生产另建 `.env.production`（不得入库），`pnpm deploy` 与 `vite build` 读它。
# 详见 content/docs/environment.zh.md 与 content/docs/cloudflare.zh.md。

# Site
# 生产部署必须改为实际域名，否则 SEO / OG 全部指向 localhost。
VITE_BASE_URL=http://localhost:3000

# Payment（Stripe）· https://docs.stripe.com/keys
VITE_PAYMENT_PROVIDER=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_YEARLY=
VITE_STRIPE_PRICE_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth · https://www.better-auth.com/docs/reference/options
# secret 用 `openssl rand -base64 32` 生成。
BETTER_AUTH_SECRET=
# 回调与重定向的绝对 URL 基址。接 Google OAuth 或邮件验证时必填，否则会随请求 origin 漂移。
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare · binding 声明在 wrangler.jsonc
# 生产 secrets 用 `wrangler secret put`，不要写进本文件。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL_SENDER=

# Email · https://resend.com/docs/api-reference/introduction
RESEND_API_KEY=
# 纯邮件地址，例如 noreply@example.com
MAIL_FROM=

# Newsletter · https://developers.beehiiv.com/welcome/create-an-api-key
RESEND_AUDIENCE_ID=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_SEND_WELCOME_EMAIL=

# Notification
DISCORD_WEBHOOK_URL=
# 飞书自定义机器人
FEISHU_WEBHOOK_URL=

# Analytics（任填启用）
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
# 必须为无凭据的 HTTPS URL
VITE_UMAMI_SCRIPT_URL=
VITE_CLARITY_PROJECT_ID=

# Captcha · https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin：逗号分隔的收件人白名单，用于 /api/email
ADMIN_EMAILS=

# Runtime
NODE_ENV=development

# deps / build artifacts (rebuilt inside the image)
node_modules
.output
.nitro
.tanstack
dist
build
src/routeTree.gen.ts
src/paraglide

# env files — .env.production is created by CI and needed at build time
# so Vite can inline VITE_* into the client bundle.
.env
.env.local
.env.development
!.env.example
!.env.production

# local database
data
drizzle

# vcs / editors / tooling
# Agent tooling (skills, MCP configs) is not needed at runtime.
.git
.github
.vscode
.idea
.cursor
.claude
.agents
.codex
.vercel
.wrangler
wrangler.jsonc
wrangler.example.jsonc

# docs & misc
# content/ is NOT ignored: the documentation markdown is read at build time
# (import.meta.glob over content/docs) and has to reach the builder.
docs
README.md
LICENSE
.DS_Store
*.log
*.pem
*.tsbuildinfo
